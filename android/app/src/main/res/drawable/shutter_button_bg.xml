<?xml version="1.0" encoding="utf-8"?>
<!-- Camera-app shutter (photo button): white ring around a white disc. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#66000000">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="3dp" android:color="#F2FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="7dp"
                android:left="7dp"
                android:right="7dp"
                android:top="7dp">
                <shape android:shape="oval">
                    <solid android:color="#F2FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
