<?xml version="1.0" encoding="utf-8"?>
<!-- One Read text block card (ReadTextSheet): number (also drawn on the still), language, copy/share; a "may be
     misread" row; the text as read (prose reflowed); one translation per target; data detector actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/read_block_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/block_number"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/read_badge_bg"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/gv_on_primary" />

        <TextView
            android:id="@+id/block_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/block_copy"
            style="@style/Widget.GlassVision.IconButton"
            android:contentDescription="@string/read_copy_block"
            android:src="@drawable/ic_copy" />

        <ImageButton
            android:id="@+id/block_share"
            style="@style/Widget.GlassVision.IconButton"
            android:contentDescription="@string/read_share_block"
            android:src="@drawable/ic_share" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/block_suspect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_error_dot"
            app:tint="@color/gv_status_busy" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/read_suspect"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/gv_status_busy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/block_careful"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="@string/read_carefully" />
    </LinearLayout>

    <TextView
        android:id="@+id/block_original"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="true" />

    <LinearLayout
        android:id="@+id/block_translations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="12dp" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/block_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:visibility="gone"
        app:chipSpacingVertical="0dp" />
</LinearLayout>
