<?xml version="1.0" encoding="utf-8"?>
<!-- Read text results (ReadTextSheet): the still with its blocks (outlined, or translated in place), the view switch
     and target languages, then a state (reading / error / no text) or one card per block and Copy all / Share all. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <pl.genor.glassvision.ReadStillView
            android:id="@+id/read_still"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@drawable/tip_bg"
            android:contentDescription="@string/read_thumbnail"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- On picture: shows the photo as taken (no translation painted over it). -->
        <com.google.android.material.chip.Chip
            android:id="@+id/read_show_original"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:checkable="true"
            android:text="@string/read_show_original"
            android:visibility="gone"
            app:chipBackgroundColor="@color/gv_scrim_glass_strong"
            app:chipStrokeColor="@color/gv_glass_stroke" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/read_view_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/read_view_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/read_view_cards"
                style="@style/Widget.GlassVision.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/read_view_cards"
                app:icon="@drawable/ic_cards"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/read_view_overlay"
                style="@style/Widget.GlassVision.Segment"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/read_view_overlay"
                app:icon="@drawable/ic_translate"
                app:iconSize="18dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/read_targets_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/read_targets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/read_target_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/read_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/read_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="40dp"
            app:trackThickness="4dp" />

        <ImageView
            android:id="@+id/read_status_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_read_text"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/read_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/read_status_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/read_retry"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/read_retry"
            android:visibility="gone"
            app:icon="@drawable/ic_read_text" />
    </LinearLayout>

    <!-- One item_read_block per block (ReadTextSheet). -->
    <LinearLayout
        android:id="@+id/read_blocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/read_all_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/read_copy_all"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/read_copy_all"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_copy"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/read_share_all"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/read_share_all"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>
