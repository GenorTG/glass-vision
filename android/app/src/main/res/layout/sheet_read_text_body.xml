<?xml version="1.0" encoding="utf-8"?>
<!-- Read text results (ReadTextSheet): the still with its line boxes, then a state (reading / error / no text)
     or the text sections (original + one per target language) and "Add language". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <pl.genor.glassvision.ReadThumbnailView
        android:id="@+id/read_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="168dp"
        android:background="@drawable/tip_bg"
        android:contentDescription="@string/read_thumbnail"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/read_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/read_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="40dp"
            app:trackThickness="4dp" />

        <ImageView
            android:id="@+id/read_status_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_read_text"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/read_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/read_status_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/read_retry"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/read_retry"
            android:visibility="gone"
            app:icon="@drawable/ic_read_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/read_sections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/read_add_language"
        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/read_add_language"
        android:visibility="gone"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart" />
</LinearLayout>
