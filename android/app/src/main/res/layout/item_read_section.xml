<?xml version="1.0" encoding="utf-8"?>
<!-- One Read text section: the original or one translation (ReadTextSheet). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/settings_group_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="4dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/section_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_read_text"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:id="@+id/section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.GlassVision.SectionHeader" />

        <ImageButton
            android:id="@+id/section_copy"
            style="@style/Widget.GlassVision.IconButton"
            android:contentDescription="@string/read_copy"
            android:src="@drawable/ic_copy" />

        <ImageButton
            android:id="@+id/section_share"
            style="@style/Widget.GlassVision.IconButton"
            android:contentDescription="@string/read_share"
            android:src="@drawable/ic_share"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/section_remove"
            style="@style/Widget.GlassVision.IconButton"
            android:contentDescription="@string/read_remove_language_plain"
            android:src="@drawable/ic_close"
            android:visibility="gone" />
    </LinearLayout>

    <!-- One TextView per block (ReadTextSheet). -->
    <LinearLayout
        android:id="@+id/section_blocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="14dp" />

    <LinearLayout
        android:id="@+id/section_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/section_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:indeterminate="true"
            app:indicatorColor="?attr/colorPrimary"
            app:indicatorSize="20dp"
            app:trackThickness="3dp" />

        <ImageView
            android:id="@+id/section_error_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_error_dot"
            android:visibility="gone" />

        <TextView
            android:id="@+id/section_state_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
