# Docker settings for glass-vision: `cp .env.example .env`, edit, `docker compose up -d`.
# (Venv installs use server/config.env instead, written by scripts/install.sh.)

# --- where the phone connects -----------------------------------------------------------------------------------
# Host address the port is published on. 127.0.0.1 = this machine only. Use your LAN IP (e.g. 192.168.1.20) or your
# Tailscale IP (`tailscale ip -4`) so the phone can reach it. 0.0.0.0 = every interface. Never expose it to the internet.
GV_BIND=127.0.0.1
# Port (host and container). The app's server address is then ws://<GV_BIND>:<GV_PORT>/ws
GV_PORT=8770

# --- security ---------------------------------------------------------------------------------------------------
# Shared secret the app must send (Settings → Connection → Token). Strongly recommended; generate one with
#   openssl rand -hex 16
# Empty = no token: anyone who can reach the port can use the server and see what the camera sees.
GV_TOKEN=

# --- compute ----------------------------------------------------------------------------------------------------
# auto = first NVIDIA GPU if usable, else CPU. Or cpu / cuda:0.
GV_DEVICE=auto
# PyTorch build baked into the image (rebuild after changing): cu130 (NVIDIA driver >= 580) or cu126 (driver >= 525).
GV_TORCH_VARIANT=cu130
# Unload a recognizer nobody used for this many seconds (frees GPU memory).
GV_IDLE_UNLOAD_S=600

# --- misc -------------------------------------------------------------------------------------------------------
# APK this server hands out for in-app updates (path inside the container; default /data/app/glass-vision.apk with
# its version in /data/app/glass-vision.apk.json — see README "Updating the app").
#GV_APK_PATH=/data/app/glass-vision.apk
# 1 = don't download models on start (pipelines whose weights are missing show an error in the app).
#GV_SKIP_MODEL_DOWNLOAD=0
# Image tag used by docker compose.
#GV_IMAGE_TAG=latest
